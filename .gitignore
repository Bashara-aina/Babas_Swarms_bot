# Octogent runtime state (NOT tentacle definitions — those are tracked)
.octogent/worktrees/
.octogent/state/
.octogent/*.json
# NOTE: .octogent/tentacles/ IS tracked — CONTEXT.md + todo.md are source of truth

# session_watcher runtime state (never commit these)
.session_state/watcher.pid
.session_state/watcher.log
.session_state/current.json
.session_state/llm_events.log
.session_state/STOP_WATCHER
.session_state/recalled_context.md
.session_state/checkpoints/
!.session_state/checkpoints/.gitkeep

# Claude-flow runtime state (regenerated by daemon, not source of truth)
.claude-flow/daemon-state.json
.claude-flow/metrics/last-session.json
.claude-flow/metrics/swarm-activity.json
.claude-flow/metrics/v3-progress.json
.claude-flow/security/audit-status.json
.claude-flow/mcp/claude-code-bridge.py
.claude-flow/mcp/context_synthesizer.py
.claude-flow/mcp/hermes-mcp-server.py
.claude-flow/mcp/memory_extractor.py

# Aider / external tool runtime history (regenerated each session)
.aider.chat.history.md

# Mirofish one-off integration status (regenerated by setup script)
.mirofish-integration-status.md

# Archived wiki content (regenerate from source notes)
.wiki/_archive/
/.wiki/Archive/

# Swarm SQLite WAL/SHM files (transient, never commit sidecars)
.swarm/memory.db-shm
.swarm/memory.db-wal

# Negate the above for tentacles (the scattered project dirs above include cekwajar/ etc.)
!.octogent/tentacles/cekwajar/
!.octogent/tentacles/legion-core/
!.octogent/tentacles/mirofish/
!.octogent/tentacles/rumahlabuh/
!.octogent/tentacles/research/
!.octogent/tentacles/popw/

# Archived skills (regenerated on demand)
.skills-archive/

# OpenCode Go runtime config (regenerated)
.opencode/

# Headroom compression cache
.headroom/

# Wiki vault (separate knowledge system)
.wiki/

# Large binary models (regenerate from training)
yolov8*.pt

