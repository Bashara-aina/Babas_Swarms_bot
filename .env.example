# ============================================================
# Legion Swarm Bot — Environment Variables
# ============================================================

# --- Core ---
TELEGRAM_BOT_TOKEN=         # Your Telegram bot token
ALLOWED_USER_ID=            # Primary Telegram user id (required by main.py)
BASHARA_TELEGRAM_ID=        # Optional alias; main.py may use first id from ALLOWED_USER_IDS
ALLOWED_USER_IDS=           # Optional comma-separated ids for multi-user experiments

# --- MiniMax (Primary LLM) ---
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1

# --- LLM APIs ---
GROQ_API_KEY=               # Groq API key
OPENAI_API_KEY=             # OpenAI (optional)
GEMINI_API_KEY=             # Google Gemini (optional)
ANTHROPIC_API_KEY=          # Anthropic Claude (fallback)
OPENROUTER_API_KEY=         # OpenRouter (optional)

# --- Local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Memory (Phase 1 — mem0) ---
MEM0_LLM_MODEL=groq/llama-3.3-70b-versatile
# Optional: Mem0 Cloud / hosted API (OSS local mode ignores this)
MEM0_API_KEY=
# Use Supabase Postgres + pgvector instead of local Chroma (set connection string)
MEM0_USE_SUPABASE=0
SUPABASE_DB_URL=
# Vector dim must match embedder + pgvector column (768 nomic-embed-text, 1536 OpenAI-class)
MEM0_EMBEDDING_DIMS=768
MEM0_COLLECTION_NAME=legion_memories
MEM0_CHROMA_PATH=~/.legion/mem0_chroma

# --- LLM Wiki (Karpathy pattern, wiki/ directory) ---
LEGION_WIKI_ENABLED=1
# Fast models for wiki ingest / index / lint (Groq recommended)
LEGION_WIKI_LLM_MODEL=groq/llama-3.3-70b-versatile
LEGION_WIKI_ROUTER_MODEL=groq/llama-3.1-8b-instant

# --- Memory (Phase 2 — MemoryOS) ---
MEMORYOS_LLM_MODEL=llama-3.3-70b-versatile
MEMORYOS_EMBED_MODEL=nomic-embed-text

# --- Supabase (rumahlabuh.com) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Email ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_SERVER=
SMTP_SERVER=

# --- n8n Automation (Phase 4) ---
N8N_PORT=5678
N8N_WEBHOOK_PORT=7835
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# --- AgentOps (Phase 6) ---
AGENTOPS_API_KEY=           # Optional — agentops.ai session replay & cost tracking

# --- Voice Engine (Phase 7) ---
KOKORO_VOICE=af_bella       # Kokoro TTS voice ID (af_bella, af_sky, am_adam, etc.)
KOKORO_SPEED=1.0            # TTS playback speed
WHISPER_MODEL=base          # faster-whisper model: tiny/base/small/medium/large-v3
WHISPER_DEVICE=cuda         # cuda (RTX 3060) or cpu

# --- MindBus Routing ---
ROUTING_MODEL=groq/llama-3.3-70b-versatile

# --- WhatsApp Bridge ---
WA_SIDECAR_PORT=3002

# --- LiveKit (optional voice rooms) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Screenpipe (local screen/audio recall, http://127.0.0.1:3030) ---
SCREENPIPE_ENABLED=0
SCREENPIPE_URL=http://127.0.0.1:3030
SCREENPIPE_PROACTIVE_ENABLED=1
SCREENPIPE_MONITOR_INTERVAL_SEC=300
SCREENPIPE_PROACTIVE_COOLDOWN_SEC=1800
SCREENPIPE_CONTEXT_LIMIT=3
SCREENPIPE_CONTEXT_HOURS=24
SCREENPIPE_ASSESS_MODEL=groq/llama-3.1-8b-instant
SCREENPIPE_MESSAGE_MODEL=groq/llama-3.3-70b-versatile

# --- Tier-3 tools ---
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
AGENT_S_WEBHOOK_URL=
LEGION_RAG_ENABLED=0
LEGION_RAG_COLLECTION=legion_rag
# chroma (default) or ragflow when RAGFlow HTTP API is configured
LEGION_RAG_BACKEND=chroma
RAGFLOW_API_BASE=
RAGFLOW_API_KEY=
RAGFLOW_DATASET_ID=
# Override if your RAGFlow build uses a different path
RAGFLOW_RETRIEVAL_PATH=/api/v1/retrieval
CHROMADB_HOST=127.0.0.1
CHROMADB_PORT=8000

# --- Research pipeline (optional fast path for /research) ---
# When 1, /research uses agents.research_agent (Tavily + researcher chat) instead of full swarm
LEGION_RESEARCH_USE_PIPELINE=0

# --- GPT-Researcher ---
GPTR_LLM_MODEL=openai/gpt-4o-mini
GPTR_SMART_MODEL=anthropic/claude-3-5-haiku
GPTR_SEARCH_API=duckduckgo

# --- Simulation agent (scenario extraction model) ---
LEGION_SIM_SCENARIO_MODEL=groq/llama-3.1-8b-instant

# --- Task router (core/task_router.py) — parallel specialist routing before AutonomousRouter ---
LEGION_TASK_ROUTER_ENABLED=0
LEGION_TASK_ROUTER_STREAM=0
LEGION_TASK_ROUTER_CLASSIFY_MODEL=groq/llama-3.1-8b-instant
LEGION_TASK_ROUTER_MAX_PARALLEL=4

# --- Prompt layers ---
LEGION_EMOTION_PROMPT_ENABLED=1
LEGION_RESPONSE_FILTER_ENABLED=0
LEGION_RESPONSE_FILTER_MIN_CHARS=6000
LEGION_RESPONSE_FILTER_MODEL=groq/llama-3.1-8b-instant
LEGION_SKILLS_PROMPT_ENABLED=1
LEGION_KNOWLEDGE_GRAPH_ENABLED=0
COGNEE_ENABLED=0

# --- Self-update watcher (scripts/self_update_watcher.py) ---
SELF_UPDATE_NOTIFY=0

# --- Weekly trending scan (scripts/legion_trending_watcher.py) ---
LEGION_TRENDING_NOTIFY=0

# --- /jarvis one-shot orchestration (core/jarvis_orchestrator.py) ---
# Plain-text autoroute: skill jarvis_orchestrate → same bundle as /jarvis (set 0 to disable)
LEGION_JARVIS_AUTOROUTE_ENABLED=1
LEGION_JARVIS_MODEL=groq/llama-3.3-70b-versatile
LEGION_JARVIS_MEMORY=1
LEGION_JARVIS_SCREENPIPE=1
LEGION_JARVIS_SCREENPIPE_LIMIT=5
LEGION_JARVIS_SCREENPIPE_HOURS=4
LEGION_JARVIS_WHATSAPP=1
LEGION_JARVIS_WA_LIMIT=12
# Set 1 if an MCP whatsapp server is configured in config/mcp_config.json
LEGION_JARVIS_MCP_WHATSAPP=0
LEGION_MCP_WHATSAPP_SERVER=whatsapp
# Optional: include MCP calendar in bundle (may add latency)
LEGION_JARVIS_CALENDAR=0
LEGION_JARVIS_CALENDAR_DAYS=3
LEGION_JARVIS_CALENDAR_TIMEOUT_SEC=2.5
LEGION_JARVIS_EMOTION=1

# --- v9 Soul Transplant ---
# Composio (850+ tool connectors: Gmail, Calendar, WhatsApp, GitHub...)
COMPOSIO_API_KEY=

# Dify self-hosted AI workflow platform
DIFY_API_URL=http://localhost:5001
DIFY_API_KEY=
DIFY_SECRET_KEY=
DIFY_DB_PASSWORD=

# Google Places API (restaurant/hotel recommendations near Koto City, Tokyo)
GOOGLE_PLACES_API_KEY=

# OpenWeatherMap (current weather — free tier)
OPENWEATHER_API_KEY=

# Browser automation (browser-use library) — any OpenAI-compatible model string
# e.g. openrouter/google/gemini-flash-1.5  or  gpt-4o-mini
BROWSER_USE_MODEL=openrouter/google/gemini-flash-1.5

# rumahlabuh.com URL for site health checks
RUMAHLABUH_URL=https://rumahlabuh.com

# Curiosity engine limits
MAX_PROACTIVE_PER_DAY=3
CURIOSITY_INTERVAL_MIN=60
CURIOSITY_QUIET_MIN=30

# Docker optional profiles:
#   docker compose --profile livekit up -d livekit
#   docker compose --profile screenpipe up -d screenpipe


# --- Daily Intelligence Harvester ---
HARVESTER_ENABLED=1
HARVESTER_TELEGRAM_DAYS=7       # Days of Telegram history to analyze per topic
HARVESTER_GIT_DAYS=3          # Days of git log to analyze per topic
HARVESTER_WIKI_MODEL=groq/llama-3.3-70b-versatile   # Model for wiki operations
HARVESTER_JUDGE_MODEL=anthropic/claude-sonnet-4      # Judge agent model
HARVESTER_FACTCHECK_MODEL=anthropic/claude-sonnet-4 # Fact-checker model
HARVESTER_PROSECUTOR_MODEL=minimax/M2.7             # Prosecutor/Defender model
# ─────────────────────────────────

# Auto-added from .env audit (April 11, 2026)
# CEREBRAS_API_KEY=
# HF_TOKEN=
LEGION_FALLBACK_MODEL=
LEGION_LANGUAGE=
LEGION_OWNER=
LEGION_PRIMARY_MODEL=
