MINIMAX_GROUP_ID=
MINIMAX_IMAGE_GEN_ENABLED=
MINIMAX_MCP_ENABLED=
MINIMAX_SPEECH_ENABLED=
MINIMAX_WEB_SEARCH_ENABLED=
# ZAI_API_KEY=

# --- markitdown (document parser) ---
MARKITDOWN_LLM_VISION=False  # Use LLM for image OCR (costs tokens)

