# ============================================================
# Legion Swarm Bot — Environment Variables
# ============================================================

# --- Core ---
TELEGRAM_BOT_TOKEN=         # Your Telegram bot token
ALLOWED_USER_IDS=           # Comma-separated Telegram user IDs

# --- LLM APIs ---
GROQ_API_KEY=               # Groq API key
OPENAI_API_KEY=             # OpenAI (optional)
GEMINI_API_KEY=             # Google Gemini (optional)
ANTHROPIC_API_KEY=          # Anthropic Claude (optional)
OPENROUTER_API_KEY=         # OpenRouter (optional)

# --- Local Ollama ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Memory (Phase 1 — mem0) ---
MEM0_LLM_MODEL=groq/llama-3.3-70b-versatile

# --- Memory (Phase 2 — MemoryOS) ---
MEMORYOS_LLM_MODEL=llama-3.3-70b-versatile
MEMORYOS_EMBED_MODEL=nomic-embed-text

# --- Supabase (rumahlabuh.com) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Email ---
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_SERVER=
SMTP_SERVER=

# --- n8n Automation (Phase 4) ---
N8N_PORT=5678
N8N_WEBHOOK_PORT=7835
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# --- AgentOps (Phase 6) ---
AGENTOPS_API_KEY=           # Optional — agentops.ai session replay & cost tracking

# --- Voice Engine (Phase 7) ---
KOKORO_VOICE=af_bella       # Kokoro TTS voice ID (af_bella, af_sky, am_adam, etc.)
KOKORO_SPEED=1.0            # TTS playback speed
WHISPER_MODEL=base          # faster-whisper model: tiny/base/small/medium/large-v3
WHISPER_DEVICE=cuda         # cuda (RTX 3060) or cpu

# --- MindBus Routing ---
ROUTING_MODEL=groq/llama-3.3-70b-versatile

# --- WhatsApp Bridge ---
WA_SIDECAR_PORT=3002

# --- LiveKit (optional voice rooms) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
