{
  "version": "2.2.0",
  "description": "ECC Native Hook Manifest \u2014 declarative spec for hook architecture. Settings.json contains the authoritative, active hook chain. This file documents the architecture; it is not consumed by Claude Code directly.",
  "active_chain": "see .claude/settings.json hooks block",
  "profiles": {
    "minimal": "Security checks only. No observations, no monitoring.",
    "standard": "Security + governance + quality gate + session activity. Default.",
    "strict": "Full auditing: all hooks enabled, context monitor active, desktop notify on stop."
  },
  "active_hooks": {
    "PreToolUse": {
      "Bash": [
        "security-prehook.sh"
      ],
      "Write|Edit|MultiEdit": [
        "gateguard-pre-edit.sh",
        "ecc-config-protection.sh",
        "ecc-governance-capture.sh"
      ]
    },
    "PostToolUse": {
      "Write|Edit|MultiEdit|Bash": [
        "capture-observation.sh"
      ],
      "*": [
        "ecc-quality-gate.sh",
        "ecc-context-monitor.sh"
      ]
    },
    "SessionStart": [
      "superpowers-inject.sh",
      "ecc-session-activity.sh"
    ],
    "SessionEnd": [
      "auto-memory-maintenance.sh",
      "auto-prune-tasks.sh"
    ]
  },
  "deprecated_spec_entries": {
    "note": "Moved to .claude/{hooks,bin}/.deprecated/ and excluded from git tracking. Active chain is in .claude/settings.json.",
    "scripts": [
      "hook-profile.sh",
      "ecc-fable5-pre.sh",
      "ecc-fable5-post.sh",
      "ecc-mcp-health-check.sh",
      "ecc-metrics-bridge.sh",
      "consolidate-observations.sh",
      "ecc-evaluate-session.sh"
    ],
    "orphan_files": [
      "auto-start-services.sh",
      "ecc-cost-tracker.sh",
      "ecc-desktop-notify.sh",
      "ecc-format-typecheck.sh"
    ],
    "deprecated_wrappers": [
      ".claude/bin/claude-go-wrapper.sh (replaced by scripts/efficient-claude-wrapper.sh)",
      ".claude/bin/claude-nemotron-wrapper.sh (already self-marked deprecated)",
      ".claude/bin/claude-openrouter-wrapper.sh (no callers in settings or bashrc)"
    ]
  },
  "profiles_available": [
    "minimal",
    "standard",
    "strict"
  ],
  "events": [
    "PreToolUse",
    "PostToolUse",
    "UserPromptSubmit",
    "PreCompact",
    "SessionStart",
    "SessionEnd"
  ]
}