{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/security-prehook.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/gateguard-pre-edit.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-config-protection.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-governance-capture.sh",
            "timeout": 3000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/capture-observation.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/track_context.py\" register \"${CLAUDE_TOOL_NAME:-tool}\"",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-quality-gate.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-context-monitor.sh",
            "timeout": 2000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/track_context.py\" message user",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" store-user-query'",
            "timeout": 2000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" compact-auto'",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" session-restore'",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/superpowers-inject.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/session-start-trigger.mjs\"'",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-session-activity.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/track_context.py\" init",
            "timeout": 2000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" session-end'",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "\".\"/.claude/hooks/auto-memory-maintenance.sh",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/statusline.cjs\"'"
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/*)",
      "mcp__scrapling__:*",
      "mcp__local-deep-research__:*",
      "Bash(ruflo *)",
      "mcp__ruflo__:*",
      "mcp__paper-search__:*",
      "mcp__academic-search__:*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "modelRestrictions": {
    "global": {
      "allowOnly": [
        "deepseek-v4-flash",
        "opencode-go/minimax-m3",
        "minimax-m3"
      ],
      "fallbackTo": "deepseek-v4-flash"
    },
    "agents": {
      "allowOnly": [
        "deepseek-v4-flash",
        "minimax-m3"
      ]
    },
    "opus": {
      "allowOnly": [
        "minimax-m3"
      ]
    }
  },
  "attribution": {
    "commit": "Co-Authored-By: RuFlo <ruv@ruv.net>",
    "pr": "\ud83e\udd16 Generated with [RuFlo](https://github.com/ruvnet/ruflo)"
  },
  "memoryLayers": {
    "note": "Memory: auto-memory-store.json (L5 graphrag + L6 auto)."
  },
  "fable5": {
    "autonomousExecution": true,
    "neverEndOnIWill": true,
    "notWatchingRealtime": true,
    "noNarrateRouting": true,
    "noHedging": true,
    "proceedWithoutAsking": [
      "Read",
      "Write",
      "Edit",
      "Bash(python *)",
      "Bash(make check)",
      "Bash(pytest *)",
      "Bash(git *)",
      "Bash(pip *)",
      "Bash(npm *)",
      "Bash(gh *)",
      "Grep",
      "Glob",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(mkdir *)",
      "Bash(tmux *)"
    ],
    "requireConfirmation": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(kill -9 *)",
      "Bash(> *.db)"
    ],
    "blockedPermissionPhrases": [
      "can i",
      "should i",
      "shall i",
      "may i",
      "want me to",
      "do you want me to",
      "permission to",
      "would you like me to",
      "need your permission",
      "let me know if you want"
    ],
    "version": "2.0.0"
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4001",
    "ANTHROPIC_API_KEY": "dummy-key-for-claude-code",
    "ANTHROPIC_MODEL": "deepseek-v4-flash",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "minimax-m3",
    "HOOK_PROFILE": "standard",
    "HOOK_ENABLE_SECURITY": "true",
    "HOOK_ENABLE_OBSERVATIONS": "true",
    "HOOK_ENABLE_GATEGUARD": "true",
    "HOOK_ENABLE_GITNEXUS": "true",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_AGENT_LIST_IN_MESSAGES": "false",
    "CLAUDE_CODE_NO_PROMPT_FOR_REVERSIBLE": "1",
    "FABLE5_AUTONOMOUS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "mcpServers": {
    "local-deep-research": {
      "command": "/home/newadmin/miniconda3/bin/ldr-mcp"
    },
    "headroom": {
      "command": "/home/newadmin/miniconda3/bin/headroom",
      "args": [
        "mcp"
      ]
    },
    "searxng": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "/home/newadmin/swarm-bot/tools/mcpServers/searxng_mcp/server.py"
      ]
    },
    "crawl4ai": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "/home/newadmin/swarm-bot/tools/mcpServers/crawl4ai_mcp/server.py"
      ]
    },
    "scrapling": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "/home/newadmin/swarm-bot/tools/mcpServers/scrapling_mcp/server.py"
      ]
    },
    "ruflo": {
      "command": "/home/newadmin/.local/node18/bin/ruflo",
      "args": [
        "mcp",
        "start"
      ],
      "env": {
        "PATH": "/home/newadmin/.local/node18/bin:/usr/bin:/bin"
      }
    },
    "paper-search": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "-m",
        "paper_search_mcp.server"
      ],
      "env": {
        "PAPER_SEARCH_MCP_CORE_API_KEY": "",
        "PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY": ""
      }
    },
    "academic-search": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "-m",
        "academic_mcp.server"
      ]
    }
  }
}