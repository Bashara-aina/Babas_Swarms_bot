{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/security-prehook.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/gateguard-pre-edit.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-config-protection.sh",
            "timeout": 2000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\".\"/.claude/hooks/auto-memory-maintenance.sh",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "\".\"/.claude/hooks/auto-prune-tasks.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/statusline.cjs\"'"
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/*)",
      "mcp__paper-search__:*",
      "mcp__academic-search__:*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "modelRestrictions": {
    "global": {
      "allowOnly": [
        "deepseek-v4-flash",
        "kimi-k3-free",
        "minimax-m3",
        "opencode-go/minimax-m3",
        "muse-spark-1.3-contributor",
        "opencode-go/muse-spark-1.3-contributor",
        "claude-sonnet-4-6"
      ],
      "fallbackTo": "deepseek-v4-flash"
    },
    "agents": {
      "allowOnly": [
        "deepseek-v4-flash",
        "minimax-m3",
        "muse-spark-1.3-contributor"
      ]
    },
    "opus": {
      "allowOnly": [
        "minimax-m3"
      ]
    }
  },
  "attribution": {
    "commit": "Co-Authored-By: RuFlo <ruv@ruv.net>",
    "pr": "\ud83e\udd16 Generated with [RuFlo](https://github.com/ruvnet/ruflo)"
  },
  "memoryLayers": {
    "note": "Memory: auto-memory-store.json (L5 graphrag + L6 auto)."
  },
  "fable5": {
    "autonomousExecution": true,
    "neverEndOnIWill": true,
    "notWatchingRealtime": true,
    "noNarrateRouting": true,
    "noHedging": true,
    "proceedWithoutAsking": [
      "Read",
      "Write",
      "Edit",
      "Bash(python *)",
      "Bash(make check)",
      "Bash(pytest *)",
      "Bash(git *)",
      "Bash(pip *)",
      "Bash(npm *)",
      "Bash(gh *)",
      "Grep",
      "Glob",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(mkdir *)",
      "Bash(tmux *)"
    ],
    "requireConfirmation": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(kill -9 *)",
      "Bash(> *.db)"
    ],
    "blockedPermissionPhrases": [
      "can i",
      "should i",
      "shall i",
      "may i",
      "want me to",
      "do you want me to",
      "permission to",
      "would you like me to",
      "need your permission",
      "let me know if you want"
    ],
    "version": "2.0.0"
  },
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:4001",
    "ANTHROPIC_API_KEY": "dummy-key-for-claude-code",
    "ANTHROPIC_MODEL": "muse-spark-1.3-contributor",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "minimax-m3",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "muse-spark-1.3-contributor",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4-flash",
    "HOOK_PROFILE": "standard",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_AGENT_LIST_IN_MESSAGES": "false"
  },
  "mcpServers": {
    "headroom": {
      "command": "/home/newadmin/miniconda3/bin/headroom",
      "args": [
        "mcp"
      ]
    },
    "searxng": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "/home/newadmin/swarm-bot/tools/mcpServers/searxng_mcp/server.py"
      ]
    },
    "paper-search": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "-m",
        "paper_search_mcp.server"
      ],
      "env": {
        "PAPER_SEARCH_MCP_CORE_API_KEY": "",
        "PAPER_SEARCH_MCP_SEMANTIC_SCHOLAR_API_KEY": ""
      }
    },
    "academic-search": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "-m",
        "academic_mcp"
      ]
    }
  }
}