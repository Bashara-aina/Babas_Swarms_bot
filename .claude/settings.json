{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/hook-profile.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/security-prehook.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/gateguard-pre-edit.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-config-protection.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-governance-capture.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "echo '[OK] Pre-edit check passed'",
            "timeout": 500
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" post-edit'",
            "timeout": 3000
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/capture-observation.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-metrics-bridge.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-quality-gate.sh",
            "timeout": 30000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-context-monitor.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/track_context.py\" register \"${CLAUDE_TOOL_NAME:-tool}\"",
            "timeout": 2000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" store-user-query'",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/track_context.py\" message user",
            "timeout": 2000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" compact-manual'",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/consolidate-observations.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" compact-summarize'",
            "timeout": 30000
          }
        ]
      },
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" compact-auto'",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/consolidate-observations.sh",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" compact-summarize'",
            "timeout": 30000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" session-restore'",
            "timeout": 15000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/superpowers-inject.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/session-start-trigger.mjs\"'",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-session-activity.sh",
            "timeout": 2000
          },
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/auto-memory-hook.mjs\" import'",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/cognee-bridge.mjs\" import'",
            "timeout": 180000
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/track_context.py\" init",
            "timeout": 2000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" session-end && exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/create-checkpoint.cjs\"'",
            "timeout": 10000
          },
          {
            "type": "command",
            "command": "sh -c 'bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/memory-sync.sh\" & node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/auto-memory-hook.mjs\" sync & node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/cognee-bridge.mjs\" sync & python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/index-sessions.py\" & node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" dreaming-consolidate & node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" obsidian-sync & node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" cleanup-orphans & node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/hook-handler.cjs\" observation-capture & wait'",
            "timeout": 25000
          },
          {
            "type": "command",
            "command": "sh -c '\"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-evaluate-session.sh & \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-cost-tracker.sh & \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-desktop-notify.sh & \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/hooks/ecc-format-typecheck.sh & wait'",
            "timeout": 10000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh -c 'exec node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/statusline.cjs\"'"
  },
  "permissions": {
    "allow": [
      "Bash(node .claude/*)",
      "mcp__graphify__:*",
      "mcp__cognee__:*",
      "mcp__hermes__:*",
      "mcp__hermes-lite__:*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "modelRestrictions": {
    "global": {
      "allowOnly": [
        "deepseek",
        "opencode-go/minimax-m3"
      ],
      "fallbackTo": "deepseek-v4-pro"
    },
    "agents": {
      "allowOnly": [
        "deepseek-v4-pro",
        "deepseek-v4-flash",
        "minimax-m3"
      ]
    },
    "opus": {
      "allowOnly": ["minimax-m3"]
    }
  },
  "attribution": {
    "commit": "Co-Authored-By: RuFlo <ruv@ruv.net>",
    "pr": "\ud83e\udd16 Generated with [RuFlo](https://github.com/ruvnet/ruflo)"
  },
  "memoryLayers": {
    "note": "L5 (graphrag) and L6 (mem0cloud) share .claude-flow/data/auto-memory-store.json. L7 (cognee) provides knowledge-graph-backed memory via cognee-mcp-server.py. Cognee data at data/cognee/."
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "850000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "HERMES_MAX_CONTEXT_TOKENS": "1048576",
    "CLAUDE_CODE_AGENT_LIST_IN_MESSAGES": "false",
    "CLAUDE_CODE_NO_PROMPT_FOR_REVERSIBLE": "1",
    "FABLE5_AUTONOMOUS": "1"
  },
  "fable5": {
    "autonomousExecution": true,
    "neverEndOnIWill": true,
    "notWatchingRealtime": true,
    "noNarrateRouting": true,
    "noHedging": true,
    "proceedWithoutAsking": [
      "Read",
      "Write",
      "Edit",
      "Bash(python *)",
      "Bash(make check)",
      "Bash(pytest *)",
      "Bash(git *)",
      "Bash(pip *)",
      "Bash(npm *)",
      "Bash(gh *)",
      "Grep",
      "Glob",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(curl *)",
      "Bash(mkdir *)",
      "Bash(tmux *)"
    ],
    "requireConfirmation": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(kill -9 *)",
      "Bash(> *.db)"
    ],
    "blockedPermissionPhrases": [
      "can i",
      "should i",
      "shall i",
      "may i",
      "want me to",
      "do you want me to",
      "permission to",
      "would you like me to",
      "need your permission",
      "let me know if you want"
    ],
    "version": "2.0.0"
  },
  "mcpServers": {
    "hermes-lite": {
      "command": "/home/newadmin/.hermes/hermes-agent/venv/bin/python3",
      "args": [
        ".claude-flow/mcp/hermes-lite-mcp-server.py"
      ],
      "env": {
        "HERMES_REPO_PATH": "/home/newadmin/.hermes/hermes-agent"
      }
    },
    "hermes": {
      "command": "/home/newadmin/.hermes/hermes-agent/venv/bin/hermes",
      "args": ["mcp", "serve"],
      "env": {
        "HERMES_REPO_PATH": "/home/newadmin/.hermes/hermes-agent"
      }
    },
    "local-deep-research": {
      "command": "/home/newadmin/miniconda3/bin/ldr-mcp"
    },
    "headroom": {
      "command": "/home/newadmin/miniconda3/bin/headroom",
      "args": ["mcp"]
    },
    "searxng": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "/home/newadmin/swarm-bot/tools/mcpServers/searxng_mcp/server.py"
      ]
    },
    "crawl4ai": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "/home/newadmin/swarm-bot/tools/mcpServers/crawl4ai_mcp/server.py"
      ]
    },
    "cognee": {
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "/home/newadmin/swarm-bot/.claude-flow/mcp/cognee-mcp-server.py"
      ]
    }
  }
}
