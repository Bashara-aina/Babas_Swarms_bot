{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/newadmin"
      ],
      "description": "Local filesystem access for reading/writing files",
      "timeout": 30000
    },
    "git": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-git",
        "--repository",
        "/home/newadmin/swarm-bot"
      ],
      "description": "Git operations via MCP protocol",
      "timeout": 30000
    },
    "gitnexus": {
      "command": "pnpm",
      "args": [
        "dlx",
        "--allow-build=kuzu",
        "gitnexus@1.4.0",
        "mcp"
      ],
      "description": "Code intelligence and graph analysis",
      "timeout": 60000
    },
    "obsidian": {
      "command": "npx",
      "args": [
        "-y",
        "@iflow-mcp/kynlos-obsidian-mcp-server",
        "/home/newadmin/swarm-bot/.wiki"
      ],
      "description": "Obsidian vault knowledge management",
      "timeout": 30000
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      },
      "description": "Web scraping and content extraction",
      "timeout": 60000
    },
    "exa": {
      "command": "npx",
      "args": [
        "-y",
        "exa-mcp-server"
      ],
      "env": {
        "EXA_API_KEY": "${EXA_API_KEY}"
      },
      "description": "Neural search for web and code research",
      "timeout": 60000
    }
  },
  "inputs": []
}
