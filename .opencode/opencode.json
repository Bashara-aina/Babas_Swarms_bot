{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-pro",
  "provider": {
    "opencode-go": {
      "api": "https://opencode.ai/zen/go/v1",
      "env": [
        "OPENCODE_GO_API_KEY"
      ]
    },
    "openrouter": {
      "api": "http://localhost:4000/v1",
      "env": [
        "OPENROUTER_API_KEY"
      ],
      "models": {
        "nvidia/nemotron-3-ultra-550b-a55b:free": {
          "id": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
          "name": "Nemotron Free",
          "family": "nemotron",
          "limit": {
            "context": 1000000,
            "output": 65536
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "status": "active"
        }
      }
    }
  },
  "snapshot": false,
  "compaction": {
    "reserved": 65536,
    "threshold": 0.85,
    "maxContext": 1000000
  },
  "permission": {
    "*": "allow",
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "lsp": "allow",
    "ask": "allow",
    "invoke": "allow",
    "external_directory": {
      "/home/**": "allow",
      "/tmp/**": "allow",
      "/media/**": "allow",
      "/mnt/**": "allow",
      "/opt/**": "allow",
      "/srv/**": "allow",
      "/var/**": "allow",
      "/root/**": "allow",
      "/nix/**": "allow",
      "/nix/store/**": "allow",
      "/Applications/**": "allow",
      "/System/**": "allow",
      "/Library/**": "allow",
      "/usr/**": "allow",
      "/etc/**": "allow",
      "/dev/**": "allow",
      "/proc/**": "allow",
      "/sys/**": "allow"
    }
  },
  "agent": {
    "build": {
      "steps": 999,
      "permission": {
        "*": "allow"
      },
      "prompt": "You are an elite autonomous coding agent. Verify facts with evidence. Never confabulate.\n\n## ESSENTIAL MCP TOOLS\n- **gitnexus**: impact analysis before editing, code intelligence queries\n- **filesystem**: file read/write/search/list/move  \n- **git**: version control\n- **exa**: web search and URL fetch\n- **sequential-thinking**: deep reasoning on complex problems\n\n## MEMORY & SESSION\n- After significant work: `python -m core.memory.cli remember '<summary>' --agent opencode`\n- To recall: `python -m core.memory.cli recall '<topic>'`\n- Read `.session_state/remembered_context.md` at session start for prior context"
    },
    "compaction": {
      "permission": {
        "*": "allow"
      }
    },
    "summary": {
      "permission": {
        "*": "allow"
      }
    },
    "Grep": {
      "permission": {
        "*": "allow"
      }
    },
    "grep": {
      "permission": {
        "*": "allow"
      }
    }
  },
  "experimental": {
    "continue_loop_on_deny": true
  },
  "mcp": {
    "gitnexus": {
      "command": [
        "/home/newadmin/.local/node18/bin/gitnexus",
        "mcp"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "@modelcontextprotocol/server-filesystem",
        "/",
        "/home",
        "/tmp",
        "/media",
        "/mnt",
        "/opt",
        "/srv",
        "/var",
        "/root",
        "/nix",
        "/nix/store"
      ],
      "enabled": false
    },
    "crawl4ai": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "/home/newadmin/swarm-bot/tools/mcpServers/crawl4ai_mcp/server.py"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {
        "PYTHONPATH": "/home/newadmin/swarm-bot/tools/mcpServers"
      },
      "enabled": false
    },
    "browser-use": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "/home/newadmin/swarm-bot/tools/mcpServers/browser_use_mcp/server.py"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {
        "BROWSER_USE_MODEL": "opencode-go/deepseek-v4-pro",
        "LITELLM_BASE_URL": "http://localhost:4000"
      },
      "enabled": false
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "symphony": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/node",
        "/home/newadmin/swarm-bot/mcp_servers/symphony-of-one/mcp-server.js"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot/mcp_servers/symphony-of-one",
      "enabled": false
    },
    "obsidian": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/node",
        "/home/newadmin/swarm-bot/mcp_servers/obsidian-patched/index.js"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot/mcp_servers/obsidian-patched",
      "env": {
        "OBSIDIAN_VAULT_PATH": "/home/newadmin/swarm-bot/.wiki"
      },
      "enabled": false
    },
    "git": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "@mseep/git-mcp-server"
      ],
      "enabled": false
    },
    "ruflo": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/ruflo",
        "mcp",
        "start"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "enabled": false
    },
    "hermes": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "hermes",
        "mcp",
        "serve"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "enabled": false
    },
    "local-deep-research": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "/home/newadmin/miniconda3/bin/python3",
        "-m",
        "local_deep_research.mcp"
      ],
      "enabled": false
    },
    "exa": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "/home/newadmin/.local/node18/bin/exa-mcp-server"
      ],
      "enabled": false
    },
    "graphify": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/share/uv/tools/graphifyy/bin/python",
        "-m",
        "graphify.serve",
        "/home/newadmin/swarm-bot/graphify-out/graph.json"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "enabled": false
    },
    "headroom": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/headroom",
        "mcp",
        "serve"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {
        "HEADROOM_HOST": "127.0.0.1",
        "HEADROOM_PORT": "8787",
        "HEADROOM_MEMORY_STORAGE": "project",
        "HEADROOM_MEMORY_DB_PATH": "/home/newadmin/swarm-bot/.headroom/memory.db",
        "HEADROOM_TELEMETRY": "off",
        "ANTHROPIC_TARGET_API_URL": "http://127.0.0.1:4001",
        "TRANSFORMERS_OFFLINE": "1"
      },
      "enabled": false
    }
  },
  "watcher": {
    "ignore": [
      ".wiki/_quarantine/**",
      ".wiki/templates/**",
      "project/popw/working/**",
      "/media/newadmin/master/**",
      "cekwajar/**",
      "logs/**",
      "**/__pycache__/**",
      ".opencode/agents/**",
      ".claude/skills/generated/**",
      "node_modules/**",
      "**/.venv/**",
      "*.flatpak",
      "*.pdf",
      "*.zip",
      "skill_labels.zip"
    ]
  },
  "plugin": [".claude-plugin/plugin.json"]
}