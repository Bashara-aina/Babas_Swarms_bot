{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-coding-plan/MiniMax-M2.7",
  "small_model": "minimax-coding-plan/MiniMax-M2.7",
  "provider": {
    "minimax-coding-plan": {
      "api": "http://localhost:4000/v1",
      "env": [
        "MINIMAX_API_KEY"
      ]
    }
  },
  "snapshot": false,
  "compaction": {
    "reserved": 8192,
    "threshold": 1.0,
    "maxContext": 153600
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "lsp": "allow",
    "external_directory": {
      "/**": "allow",
      "/home/**": "allow",
      "/tmp/**": "allow",
      "/media/**": "allow",
      "/mnt/**": "allow",
      "/opt/**": "allow",
      "/srv/**": "allow",
      "/var/**": "allow",
      "/root/**": "allow",
      "/nix/**": "allow",
      "/nix/store/**": "allow",
      "/Applications/**": "allow",
      "/System/**": "allow",
      "/Library/**": "allow",
      "/usr/**": "allow",
      "/etc/**": "allow",
      "/dev/**": "allow",
      "/proc/**": "allow",
      "/sys/**": "allow"
    }
  },
  "agent": {
    "build": {
      "steps": 60,
      "prompt": "You have a persistent long-term memory system powered by ChromaDB. Memory context is auto-injected at session start and session end. When you complete significant work, run: python -m core.memory.cli remember '<summary>' --agent opencode to store it for future sessions. Use: python -m core.memory.cli recall '<topic>' to retrieve specific context anytime. Compaction is disabled \u2014 memory recall replaces it. Treat recalled memories as accurate prior context."
    },
    "summary": {
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  },
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/gitnexus",
        "mcp"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "@modelcontextprotocol/server-filesystem",
        "/",
        "/home",
        "/tmp",
        "/media",
        "/mnt",
        "/opt",
        "/srv",
        "/var",
        "/root",
        "/nix",
        "/nix/store"
      ]
    },
    "crawl4ai": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "/home/newadmin/swarm-bot/tools/mcpServers/crawl4ai_mcp/server.py"
      ]
    },
    "browser-use": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "-m",
        "tools.mcpServers.browser_use_mcp.server"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {
        "BROWSER_USE_MODEL": "minimax/MiniMax-M2.7",
        "LITELLM_BASE_URL": "http://localhost:4000"
      }
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "symphony": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/node",
        "/home/newadmin/swarm-bot/mcp_servers/symphony-of-one/mcp-server.js"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot/mcp_servers/symphony-of-one"
    },
    "obsidian": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/mcpServers/obsidian-patched/index.js"
      ],
      "env": {
        "OBSIDIAN_VAULT_PATH": "/home/newadmin/swarm-bot/.wiki"
      }
    },
    "git": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "@mseep/git-mcp-server"
      ]
    },
    "ruflo": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "ruflo",
        "mcp",
        "start"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot"
    },
    "hermes": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "hermes",
        "mcp",
        "serve"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot"
    },
    "local-deep-research": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "/home/newadmin/miniconda3/bin/python3",
        "-m",
        "local_deep_research.mcp"
      ]
    },
    "exa": {
      "type": "local",
      "command": [
        "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
        "/home/newadmin/.local/node18/bin/exa-mcp-server"
      ]
    }
  },
  "watcher": {
    "ignore": [
      ".wiki/_quarantine/**",
      ".wiki/templates/**",
      "project/popw/working/**",
      "/media/newadmin/master/**",
      "cekwajar/**",
      "logs/**",
      "**/__pycache__/**",
      ".opencode/agents/**",
      ".claude/skills/generated/**",
      "node_modules/**",
      "**/.venv/**",
      "*.flatpak",
      "*.pdf",
      "*.zip",
      "skill_labels.zip"
    ]
  }
}