{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": ["pnpm", "dlx", "--allow-build=kuzu", "gitnexus@1.4.0", "mcp"]
    },
    "obsidian": {
      "type": "local",
      "command": ["npx", "-y", "@iflow-mcp/kynlos-obsidian-mcp-server", "/home/newadmin/swarm-bot/.wiki"]
    },
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@mseep/git-mcp-server"]
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/newadmin"]
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "environment": {
        "FIRECRAWL_API_KEY": "fc-09da51dd5e5c46b5b73d7b1ca5cb4c74"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=2f2f6644-9907-4444-bb6b-c507b32c4820"
    }
  },
  "watcher": {
    "ignore": [
      ".wiki/_quarantine/**",
      ".wiki/templates/**",
      "project/popw/working/**",
      "cekwajar/**",
      "logs/**",
      "**/__pycache__/**"
    ]
  }
}
