{
  "$schema": "https://opencode.ai/config.json",
  "model": "minimax-coding-plan/MiniMax-M2.7",
  "small_model": "minimax-coding-plan/MiniMax-M2.7",
  "snapshot": false,
  "compaction": {
    "reserved": 8192,
    "threshold": 0.99,
    "maxContext": 204800
  },
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "lsp": "allow",
    "external_directory": {
      "/home/newadmin/**": "allow"
    }
  },
  "agent": {
    "build": {
      "steps": 60,
      "prompt": "You have a persistent long-term memory system. At the start of this session, run: python -m core.memory.cli recall '<topic>' to retrieve relevant past context. When you complete significant work, run: python -m core.memory.cli remember '<summary>' --agent opencode to store it for future sessions. Compaction is disabled \u2014 instead recall from memory. Treat recalled memories as accurate prior context."
    },
    "summary": {
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    }
  },
  "mcp": {
    "gitnexus": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/gitnexus",
        "mcp"
      ]
    },
    "obsidian": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/npx",
        "-y",
        "@iflow-mcp/kynlos-obsidian-mcp-server",
        "/home/newadmin/swarm-bot/.wiki"
      ]
    },
    "git": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/npx",
        "-y",
        "@mseep/git-mcp-server"
      ]
    },
    "filesystem": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/newadmin"
      ]
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp"
    },
    "crawl4ai": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "/home/newadmin/swarm-bot/tools/mcpServers/crawl4ai_mcp/server.py"
      ]
    },
    "symphony": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "-m",
        "mcp_servers.symphony_server"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot"
    },
    "latex": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "-m",
        "mcp_servers.latex_mcp_server"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot"
    },
    "ruflo": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "-m",
        "mcp_servers.ruflo_mcp_server"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot"
    },
    "sequential-thinking": {
      "type": "local",
      "command": [
        "/home/newadmin/.local/node18/bin/npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "hermes": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "-m",
        "mcp_servers.hermes_mcp_server"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {
        "HERMES_CLI_CONFIG": "/home/newadmin/swarm-bot/ext/hermes-agent/cli-config.yaml",
        "LITELLM_BASE_URL": "http://localhost:4000"
      }
    },
    "browser-use": {
      "type": "local",
      "command": [
        "/home/newadmin/miniconda3/bin/python3",
        "-m",
        "tools.mcpServers.browser_use_mcp.server"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {
        "BROWSER_USE_MODEL": "minimax/MiniMax-M2.7",
        "LITELLM_BASE_URL": "http://localhost:4000"
      }
    }
  },
  "watcher": {
    "ignore": [
      ".wiki/_quarantine/**",
      ".wiki/templates/**",
      "project/popw/working/**",
      "/media/newadmin/master/**",
      "cekwajar/**",
      "logs/**",
      "**/__pycache__/**",
      ".opencode/agents/**",
      ".claude/skills/generated/**",
      "node_modules/**",
      "**/.venv/**",
      "*.flatpak",
      "*.pdf",
      "*.zip",
      "skill_labels.zip"
    ]
  },
  "hooks": {
    "session:start": {
      "command": [
        "bash",
        "-c",
        "cat /tmp/legion_session_context.txt /tmp/legion_temporal_context.txt 2>/dev/null"
      ],
      "description": "Load session hot memory on start"
    },
    "session:end": {
      "command": [
        "bash",
        "-c",
        "cat > /tmp/legion_session_summary.txt << 'EOF'\nLast session summary auto-generated\nEOF"
      ],
      "description": "Save session summary to hot memory on end"
    },
    "task:complete": {
      "command": [
        "bash",
        "-c",
        "echo 'task complete' >> /tmp/legion_task_log.txt"
      ],
      "description": "Log task completion to hot memory"
    }
  }
}