{
  "$schema": "https://opencode.ai/config.json",
  "_note": "MCP server configuration - synced with .opencode/opencode.json",
  "_bootstrap": "tools/mcpServers/bootstrap/mcp_bootstrap.sh wraps npx-based servers to filter startup messages",
  "servers": [
    {
      "name": "gitnexus",
      "command": "/home/newadmin/.local/node18/bin/gitnexus",
      "args": [
        "mcp"
      ],
      "enabled": true,
      "description": "GitNexus code intelligence - graph queries, symbol analysis, execution flows"
    },
    {
      "name": "filesystem",
      "command": "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "/home/newadmin"
      ],
      "enabled": true,
      "description": "Filesystem operations via MCP - read, write, list, search files"
    },
    {
      "name": "crawl4ai",
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "/home/newadmin/swarm-bot/tools/mcpServers/crawl4ai_mcp/server.py"
      ],
      "enabled": true,
      "description": "AI-friendly web crawler - markdown, html, screenshot, pdf, crawl"
    },
    {
      "name": "browser-use",
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "-m",
        "tools.mcpServers.browser_use_mcp.server"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {
        "BROWSER_USE_MODEL": "minimax/MiniMax-M3",
        "LITELLM_BASE_URL": "http://localhost:4000"
      },
      "enabled": true,
      "description": "Browser automation via browser-use - open, click, fill, scroll, screenshot"
    },
    {
      "name": "sequential-thinking",
      "command": "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
      "args": [
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true,
      "description": "Sequential thinking for complex reasoning"
    },
    {
      "name": "symphony",
      "command": "/home/newadmin/.local/node18/bin/node",
      "args": [
        "/home/newadmin/swarm-bot/mcp_servers/symphony-of-one/mcp-server.js"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot/mcp_servers/symphony-of-one",
      "enabled": true,
      "description": "Symphony multi-agent collaboration - chat rooms, tasks, persistent memory"
    },
    {
      "name": "obsidian",
      "command": "/home/newadmin/swarm-bot/mcp_servers/obsidian-wrapper.sh",
      "args": [
        "/home/newadmin/.local/node18/bin/node",
        "/home/newadmin/swarm-bot/mcp_servers/obsidian-patched/index.js"
      ],
      "workingDirectory": "/home/newadmin/swarm-bot/mcp_servers/obsidian-patched",
      "env": {
        "OBSIDIAN_VAULT_PATH": "/home/newadmin/swarm-bot/.wiki"
      },
      "enabled": true,
      "description": "Obsidian vault knowledge management"
    },
    {
      "name": "git",
      "command": "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
      "args": [
        "@mseep/git-mcp-server"
      ],
      "enabled": false,
      "description": "Git operations via MCP (DISABLED - @mseep/git-mcp-server not installed on npm)"
    },
    {
      "name": "ruflo",
      "command": "/home/newadmin/.local/node18/bin/ruflo",
      "args": [
        "mcp",
        "start"
      ],
      "enabled": true,
      "description": "Ruflo autonomous agent system"
    },
    {
      "name": "hermes",
      "command": "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
      "args": [
        "hermes",
        "mcp",
        "serve"
      ],
      "enabled": true,
      "description": "Hermes messaging bridge - conversations, messages, events",
      "workingDirectory": "/home/newadmin/swarm-bot"
    },
    {
      "name": "local-deep-research",
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": [
        "-m",
        "local_deep_research.mcp"
      ],
      "enabled": true,
      "description": "Local deep research MCP server"
    },
    {
      "name": "exa",
      "command": "/home/newadmin/swarm-bot/tools/mcpServers/bootstrap/mcp_bootstrap.sh",
      "args": [
        "/home/newadmin/.local/node18/bin/exa-mcp-server"
      ],
      "enabled": true,
      "description": "Exa web search MCP server"
    }
  ]
}