{
  "$schema": "https://opencode.ai/config.schema.json",
  "model": "minimax-coding-plan/MiniMax-M2.7",
  "agents": {
    "planner": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.1
    },
    "worker": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.2
    },
    "reviewer": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.0
    },
    "verifier": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.0
    },
    "diff-analyzer": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.0
    },
    "wikibot": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.1
    },
    "research-agent": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.3
    },
    "build": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.0
    },
    "deployment-engineer": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.0
    },
    "focused-implementer": {
      "model": "minimax-coding-plan/MiniMax-M2.7",
      "temperature": 0.1
    }
  },
  "wiki": {
    "path": "wiki/",
    "schema": "wiki/SCHEMA.md",
    "index": "wiki/INDEX.md"
  },
  "rules": [
    "Always read wiki/SCHEMA.md before any wiki operation",
    "Always write decisions to wiki/decisions/ not .wiki/decisions/",
    "Always write logs to wiki/logs/ not .wiki/logs/"
  ]
}