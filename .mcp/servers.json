{
  "mcpServers": {
    "gitnexus": {
      "command": "gitnexus",
      "args": ["mcp"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/newadmin"],
      "enabled": true
    },
    "crawl4ai": {
      "type": "local",
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": ["/home/newadmin/swarm-bot/tools/mcpServers/crawl4ai_mcp/server.py"],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {"PYTHONPATH": "/home/newadmin/swarm-bot/tools/mcpServers"},
      "enabled": true
    },
    "browser-use": {
      "type": "local",
      "command": "/home/newadmin/miniconda3/bin/python3",
      "args": ["/home/newadmin/swarm-bot/tools/mcpServers/browser_use_mcp/server.py"],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {
        "BROWSER_USE_MODEL": "minimax/MiniMax-M2.7",
        "LITELLM_BASE_URL": "http://localhost:4000"
      },
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "symphony": {
      "type": "local",
      "command": "/home/newadmin/.local/node18/bin/node",
      "args": ["/home/newadmin/swarm-bot/mcp_servers/symphony-of-one/mcp-server.js"],
      "workingDirectory": "/home/newadmin/swarm-bot/mcp_servers/symphony-of-one",
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@iflow-mcp/kynlos-obsidian-mcp-server", "/home/newadmin/swarm-bot/.wiki"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "@mseep/git-mcp-server"],
      "enabled": true
    },
    "ruflo": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "ruflo@latest", "mcp", "start"],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "enabled": true
    },
    "local-deep-research": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "ldr-mcp"],
      "workingDirectory": "/home/newadmin/swarm-bot",
      "enabled": true
    },
    "exa": {
      "type": "local",
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "enabled": true
    }
  }
}
